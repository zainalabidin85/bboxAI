VITE_API_BASE_URL=http://localhost:8000
# Set VITE_REMOTE=true + point VITE_API_BASE_URL at your bbox-relay deployment
# to build the remote-control variant (pairing code instead of login).
VITE_REMOTE=false
# Browser tab title — set to "bboxAI-Remote" for a VITE_REMOTE=true build so
# a user with both open can tell them apart.
VITE_APP_TITLE=bboxAI-Desktop
