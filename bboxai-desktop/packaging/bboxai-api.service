[Unit]
Description=bboxAI desktop API
After=network.target postgresql.service

[Service]
Type=simple
User=bboxai
Group=bboxai
WorkingDirectory=/opt/bboxai-desktop/bbox-api
EnvironmentFile=/var/lib/bboxai-desktop/bbox-api.env
ExecStart=/var/lib/bboxai-desktop/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
