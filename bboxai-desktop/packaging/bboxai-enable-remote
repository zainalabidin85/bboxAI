#!/usr/bin/env bash
# Enables away-from-home access for a bboxai-desktop .deb install by setting
# up bbox-agent as a systemd service, tunneling to the shared bbox-relay so
# https://bboxai-remote.unitani.com can reach this machine.
#
# Run this AFTER registering a bboxAI account through the local web UI
# (http://bboxai:8321).
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this with sudo: sudo bboxai-enable-remote" >&2
  exit 1
fi

APP_DIR=/opt/bboxai-desktop
DATA_DIR=/var/lib/bboxai-desktop
SVC_USER=bboxai
API_BASE="http://localhost:8000"
RELAY_URL="https://bboxai-relay.unitani.com"
ENV_FILE="/etc/bboxai-agent.env"

USERNAME="${BBOXAI_USERNAME:-}"
PASSWORD="${BBOXAI_PASSWORD:-}"
if [ -z "$USERNAME" ]; then
  read -rp "bboxAI username: " USERNAME
fi
if [ -z "$PASSWORD" ]; then
  read -rsp "bboxAI password: " PASSWORD
  echo
fi

echo "==> Validating login against $API_BASE"
LOGIN_TMP="$(mktemp)"
trap 'rm -f "$LOGIN_TMP"' EXIT
STATUS=$(curl -s -o "$LOGIN_TMP" -w '%{http_code}' -X POST "$API_BASE/auth/login" \
  --data-urlencode "username=$USERNAME" \
  --data-urlencode "password=$PASSWORD")
if [ "$STATUS" != "200" ]; then
  echo "Login failed (HTTP $STATUS). Register an account at http://bboxai:8321 first." >&2
  exit 1
fi
echo "    login OK"

echo "==> Setting up bbox-agent venv"
if [ ! -d "$DATA_DIR/agent-venv" ]; then
  python3 -m venv "$DATA_DIR/agent-venv"
fi
# shellcheck disable=SC1091
source "$DATA_DIR/agent-venv/bin/activate"
pip install --upgrade pip -q
pip install -q -r "$APP_DIR/bbox-agent/requirements.txt"
deactivate
chown -R "$SVC_USER:$SVC_USER" "$DATA_DIR/agent-venv"

echo "==> Writing $ENV_FILE"
cat > "$ENV_FILE" <<EOF
BBOXAI_API_BASE=$API_BASE
BBOXAI_RELAY_URL=$RELAY_URL
BBOXAI_USERNAME=$USERNAME
BBOXAI_PASSWORD=$PASSWORD
EOF
chmod 600 "$ENV_FILE"

echo "==> Installing bboxai-agent.service"
cp "$APP_DIR/packaging/bboxai-agent.service" /etc/systemd/system/bboxai-agent.service
systemctl daemon-reload
systemctl enable --now bboxai-agent.service
systemctl restart bboxai-agent.service

echo
echo "================================================================"
echo " bbox-agent is running and tunneling to $RELAY_URL."
echo " Log into https://bboxai-remote.unitani.com with the same"
echo " bboxAI account from anywhere."
echo "================================================================"
